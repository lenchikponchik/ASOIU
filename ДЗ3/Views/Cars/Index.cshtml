@model List<Car>
@{ ViewData["Title"] = "Автомобили"; }

<h2>Автомобили</h2>

@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

<a asp-action="Create" class="btn btn-primary mb-3">+ Добавить автомобиль</a>

<table class="table table-bordered table-hover table-sm">
    <thead class="table-dark">
        <tr>
            <th>Марка</th>
            <th>Модель</th>
            <th>Мощность (л.с.)</th>
            <th style="width:160px"></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var c in Model)
    {
        <tr>
            <td>@c.Brand?.Name</td>
            <td>@c.Name</td>
            <td>@c.Horsepower</td>
            <td>
                <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary">Изменить</a>
                <form method="post" asp-action="Delete" asp-route-id="@c.Id" class="d-inline"
                      onsubmit="return confirm('Удалить «@c.Brand?.Name @c.Name»?')">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
